// File name: projects/3/a/RAM8.hdl
/**
 * Memory of eight 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    DMux8Way(in=load , sel=address[0..2] , a=a , b=b , c=c , d=d , e=e , f=f , g=g , h=h );
    Register(in=in[0..15] , load=a , out=a1 );
    Register(in=in[0..15] , load=b , out=b1 );
    Register(in=in[0..15] , load=c , out=c1 );
    Register(in=in[0..15] , load=d , out=d1 );
    Register(in=in[0..15] , load=e , out=e1 );
    Register(in=in[0..15] , load=f , out=f1 );
    Register(in=in[0..15] , load=g , out=g1 );
    Register(in=in[0..15] , load=h , out=h1 );
    Mux8Way16(a=a1 , b=b1 , c=c1 , d=d1 , e=e1 , f=f1 , g=g1 , h=h1 , sel=address[0..2] , out=out );
}